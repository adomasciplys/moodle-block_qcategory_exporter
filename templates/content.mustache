{{!
    @template @template block_qcategory_exporter/content

    Outer shell of block

    Developed by Innowell

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
        "name": "value"
    }
}}

<div class="block_qcategory_exporter">
  <h2>{{#str}}pluginname, block_qcategory_exporter{{/str}}</h2>
  {{#categories}}
  <div>{{name}}</div>
  {{/categories}}
  <p>
     <form method="post" action="{{actionurl}}">
         <input type="hidden" name="sesskey" value="{{sesskey}}">
         <input type="hidden" name="courseid" value="{{courseid}}">
         <input type="hidden" name="categories" value="{{categoryids}}">
         <button type="submit" class="btn btn-secondary">
             {{#str}}importcategories, block_qcategory_exporter{{/str}}
         </button>
     </form>
</p>
</div>