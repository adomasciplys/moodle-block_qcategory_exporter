{{!
    @template block_qcategory_exporter/content

    Outer shell of block

    @copyright 2025 Innowell
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * actionurl - URL of the page the Import button posts to
    * sesskey - session key of the current user
    * courseid - id of the course the block is in
    * categoryids - comma separated ids of the categories to import
    * categories - list of the categories to import, each with a name

    Example context (json):
    {
        "actionurl": "https://example.com/blocks/qcategory_exporter/copy_to_course.php",
        "sesskey": "abc123",
        "courseid": 2,
        "categoryids": "12,34",
        "categories": [
            {"name": "Old course: Category name"}
        ]
    }
}}

<div class="block_qcategory_exporter">
  <h2>{{#str}}pluginname, block_qcategory_exporter{{/str}}</h2>
  {{#categories}}
  <div>{{name}}</div>
  {{/categories}}
  <form method="post" action="{{actionurl}}">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="courseid" value="{{courseid}}">
    <input type="hidden" name="categories" value="{{categoryids}}">
    <button type="submit" class="btn btn-secondary">
      {{#str}}importcategories, block_qcategory_exporter{{/str}}
    </button>
  </form>
</div>
